# OpenAI-SDK-compatible provider — Mistral default.
# Swap to OpenAI / Groq / Together by editing the four vars below.
OPENAI_COMPAT_BASE_URL=https://api.mistral.ai/v1
OPENAI_COMPAT_API_KEY=your_key_here
OPENAI_COMPAT_CHAT_MODEL=mistral-large-latest
OPENAI_COMPAT_EMBED_MODEL=mistral-embed
EMBEDDING_DIMS=1024
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4000

# Auth — JWT signing secret. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_MINUTES=30
BCRYPT_ROUNDS=12

# Tortoise / SQLite (User, MemoryVector, MemoryHistory).
# Relative paths anchor to the backend/ folder, not cwd.
DATABASE_URL=sqlite://data/memorai.db

# Optional overrides — defaults shown.
# VECTOR_DB_PATH=data/vectors.db
# VECTOR_COLLECTION=memories
# GRAPH_DB_PATH=data/graph
# GRAPH_ENABLED=true
# GRAPH_THRESHOLD=0.7

# Logging — see app/core/logging_utils.py for profiles.
# LOG_PROFILE=standard
# LOG_LEVEL=INFO

# LLM outbound rate limits — chat and embeddings run on independent
# buckets (one req in-flight at a time per client). Defaults sit just
# above Mistral's free-tier ~1 RPS cap; the in-bucket retry-on-429
# catches any momentary overshoot. Tune them independently if a
# provider throttles one client harder than the other.
# LLM_CHAT_RATE_LIMIT_RPS=1.5
# LLM_EMBED_RATE_LIMIT_RPS=1.5
