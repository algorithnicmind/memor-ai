# OpenAI-SDK-compatible provider — Mistral default.
# Swap to OpenAI / Groq / Together by editing the four vars below.
OPENAI_COMPAT_BASE_URL=https://api.mistral.ai/v1
OPENAI_COMPAT_API_KEY=your_key_here
OPENAI_COMPAT_CHAT_MODEL=mistral-large-latest
OPENAI_COMPAT_EMBED_MODEL=mistral-embed

# Optional: separate API key for embeddings. When set, the embedder
# uses this key instead of OPENAI_COMPAT_API_KEY, giving it its own
# RPS quota (e.g. a second Mistral account or a different provider
# entirely). Leave unset to share the key above with chat.
# OPENAI_COMPAT_EMBED_API_KEY=your_second_key_here

EMBEDDING_DIMS=1024
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4000

# Auth — JWT signing secret. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_MINUTES=30
BCRYPT_ROUNDS=12

# Tortoise / SQLite (User, MemoryVector, MemoryHistory).
# Relative paths anchor to the backend/ folder, not cwd.
DATABASE_URL=sqlite://data/memorai.db

# Optional overrides — defaults shown.
# VECTOR_DB_PATH=data/vectors.db
# VECTOR_COLLECTION=memories
# GRAPH_DB_PATH=data/graph
# GRAPH_ENABLED=true
# GRAPH_THRESHOLD=0.7

# Logging — see app/core/logging_utils.py for profiles.
# LOG_PROFILE=standard
# LOG_LEVEL=INFO

# LLM outbound rate limits — chat and embeddings each have their own
# bucket (capacity 1, refill at the configured RPS). Defaults of 0.8
# sit under Mistral's free-tier 1 RPS cap with headroom for clock
# skew; combined ceiling is ~1.6 RPS when OPENAI_COMPAT_EMBED_API_KEY
# is set (separate quotas). Paid tiers should bump these.
# LLM_CHAT_RATE_LIMIT_RPS=0.8
# LLM_EMBED_RATE_LIMIT_RPS=0.8
